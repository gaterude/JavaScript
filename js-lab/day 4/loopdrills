// 1. for loop: Print numbers 1 to 20
console.log("1. Numbers 1 to 20:");
for (let i = 1; i <= 20; i++) {
  console.log(i);
}

// ===============================
// 2. while loop: Countdown 10 to 1
// ===============================
console.log("\n2. Countdown:");
let count = 10;

while (count >= 1) {
  console.log(count);
  count--;
}

// ===============================
// 3. do...while loop
// Runs at least once even when condition is false
// ===============================
console.log("\n3. do...while Example:");
let num = 5;

do {
  console.log("This runs once even though the condition is false.");
} while (num < 5);


// ===============================
// 4. for loop with break
// Stop at the first multiple of 7 between 1 and 100
// ===============================
console.log("\n4. First multiple of 7:");

for (let i = 1; i <= 100; i++) {
  if (i % 7 === 0) {
    console.log(i);
    break;
  }
}


// ===============================
// 5. for loop with continue
// Print only odd numbers from 1 to 20
// ===============================
console.log("\n5. Odd numbers:");

for (let i = 1; i <= 20; i++) {
  if (i % 2 === 0) {
    continue;
  }
  console.log(i);
}


// ===============================
// 6. FizzBuzz (1 to 30)
// ===============================
console.log("\n6. FizzBuzz:");

for (let i = 1; i <= 30; i++) {
  if (i % 3 === 0 && i % 5 === 0) {
    console.log("FizzBuzz");
  } else if (i % 3 === 0) {
    console.log("Fizz");
  } else if (i % 5 === 0) {
    console.log("Buzz");
  } else {
    console.log(i);
  }
}